+static td_void cmos_inttime_update_linear(ot_isp_sns_state *sns_state, td_u32 int_time)
+{
+    td_u32 val;
+
+    val = (int_time > IMX662_FULL_LINES_MAX) ? IMX662_FULL_LINES_MAX : int_time;
+
+    sns_state->regs_info[1].i2c_data[VALUE_IDX].data = 0x00;
+    sns_state->regs_info[0].i2c_data[EXP_REG_MSB_IDX].data = (val >> 16) & 0xF;
+    sns_state->regs_info[0].i2c_data[EXP_REG_MID_IDX].data = (val >> 8) & 0xFF;
+    sns_state->regs_info[0].i2c_data[EXP_REG_LSB_IDX].data = val & 0xFF;
+    sns_state->regs_info[0].i2c_data[VALUE_IDX].data = 0x01;
+
+    return;
+}
