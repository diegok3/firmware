+
+static td_s32 cmos_get_ae_default(ot_vi_pipe vi_pipe, ot_isp_ae_sensor_default *ae_sns_dft)
+{
+    cis_info *cis = TD_NULL;
+    ot_isp_sns_state *sns_state = TD_NULL;
