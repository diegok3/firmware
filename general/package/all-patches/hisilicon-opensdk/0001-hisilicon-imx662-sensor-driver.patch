+static td_void cmos_get_ae_linear_default(cis_info *cis, ot_isp_ae_sensor_default *ae_sns_dft,
+    const ot_isp_sns_state *sns_state)
+{
+    ae_sns_dft->max_again = IMX662_AGAIN_MAX;
