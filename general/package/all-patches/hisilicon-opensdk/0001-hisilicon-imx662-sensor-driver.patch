+    IMX662_MODE_MAX
+} imx662_res_mode;
+
+/* register array index for per-frame updates */
+typedef enum {
+    PAGE_IDX = 0,
+    EXP_REG_MSB_IDX,
+    EXP_REG_MID_IDX,
+    EXP_REG_LSB_IDX,
+    VMAX_REG_MSB_IDX,
+    VMAX_REG_MID_IDX,
+    VMAX_REG_LSB_IDX,
+    AGAIN_REG_LSB_IDX,
+    AGAIN_REG_MSB_IDX,
