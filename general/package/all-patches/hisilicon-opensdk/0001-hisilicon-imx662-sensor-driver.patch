+static td_s32 cmos_isp_set_wdr_mode(ot_vi_pipe vi_pipe, td_u8 mode)
+{
+    CB_TRACE();
+    ot_isp_sns_state *sns_state = TD_NULL;
+
+    sns_check_pipe_return(vi_pipe);
