+static td_void cmos_config_vmax(ot_isp_sns_state *sns_state, td_u32 vmax)
+{
+    sns_state->regs_info[1].i2c_data[VALUE_IDX].data = 0x00;
+    sns_state->regs_info[0].i2c_data[VMAX_REG_MSB_IDX].data = (vmax >> 16) & 0xF;
+    sns_state->regs_info[0].i2c_data[VMAX_REG_MID_IDX].data = (vmax >> 8) & 0xFF;
+    sns_state->regs_info[0].i2c_data[VMAX_REG_LSB_IDX].data = vmax & 0xFF;
+    sns_state->regs_info[0].i2c_data[VALUE_IDX].data = 0x01;
+}
+
+static td_void cmos_fps_set(ot_vi_pipe vi_pipe, td_float fps, ot_isp_ae_sensor_default *ae_sns_dft)
+{
+    CB_TRACE();
+    td_u32 vmax;
+    td_float max_fps = IMX662_LINEAR_FRAMERATE;
+    cis_info *cis = TD_NULL;
+    ot_isp_sns_state *sns_state = TD_NULL;
+
+    sns_check_pipe_void_return(vi_pipe);
+    sns_check_pointer_void_return(ae_sns_dft);
+
+    cis = cmos_get_info(vi_pipe);
+    sns_check_pointer_void_return(cis);
+
+    sns_state = cis->sns_state;
+    sns_check_pointer_void_return(sns_state);
+
+    vmax = (td_u32)(IMX662_VMAX_DEFAULT * max_fps / fps);
+    vmax = (vmax < IMX662_VMAX_DEFAULT) ? IMX662_VMAX_DEFAULT : vmax;
+    vmax = (vmax > IMX662_FULL_LINES_MAX) ? IMX662_FULL_LINES_MAX : vmax;
+
+    cmos_config_vmax(sns_state, vmax);
+
+    sns_state->fl_std = vmax;
+    ae_sns_dft->lines_per500ms = (td_u32)(IMX662_VMAX_DEFAULT * max_fps / 2);
+
+    ae_sns_dft->fps = fps;
+    ae_sns_dft->full_lines_std = sns_state->fl_std;
+    ae_sns_dft->max_int_time = sns_state->fl_std - IMX662_FL_OFFSET_LINEAR;
+    sns_state->fl[0] = sns_state->fl_std;
+    ae_sns_dft->full_lines = sns_state->fl[0];
+    ae_sns_dft->hmax_times = (td_u32)(1000000000ULL / (sns_state->fl_std * max_fps));
+
+    return;
+}
