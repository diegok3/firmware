+#define IMX662_MAX_INT_TIME_TARGET               65535
+
+/* Piris (iris) */
+#define IMX662_PIRIS_ATTR                             OT_ISP_IRIS_HW
+
+/* Black level */
+#define IMX662_BLACK_LEVEL_DEFAULT                      0x100
+#define IMX662_BLACK_LEVEL_MIN                          0x000
+#define IMX662_BLACK_LEVEL_MAX                          0xFFF
+
+/* DNG/WB calibration - placeholders, need to be populated from sensor datasheet */
+#define IMX662_CALIBRATE_STATIC_TEMP              5000
+#define IMX662_CALIBRATE_STATIC_WB_R_GAIN         256
+#define IMX662_CALIBRATE_STATIC_WB_GR_GAIN        256
+#define IMX662_CALIBRATE_STATIC_WB_GB_GAIN        256
+#define IMX662_CALIBRATE_STATIC_WB_B_GAIN         256
+
+#define IMX662_CALIBRATE_AWB_P1                     0
+#define IMX662_CALIBRATE_AWB_P2                     256
+#define IMX662_CALIBRATE_AWB_Q1                     0
+#define IMX662_CALIBRATE_AWB_A1                11800
+#define IMX662_CALIBRATE_AWB_B1                10240
+#define IMX662_CALIBRATE_AWB_C1                        0
+
+#define IMX662_GOLDEN_RGAIN                         0
+#define IMX662_GOLDEN_BGAIN                         0
+
+/* WDR */
+#define IMX662_WDR_MODE_NONE                  OT_WDR_MODE_NONE
+#define IMX662_WDR_MODE_SHORT             OT_WDR_MODE_SHORT
+#define IMX662_WDR_MODE_LONG                 OT_WDR_MODE_LONG
+
+/* Input clock */
+#define IMX662_INPUT_CLOCK                       27000000
+
+/* VMAX register addresses (20-bit, 3 bytes) */
+#define IMX662_VMAX_REG_LSB                          0x3028
+#define IMX662_VMAX_REG_MID                          0x3029
+#define IMX662_VMAX_REG_MSB                          0x302A
+
+/* HMAX register addresses (12-bit, 2 bytes) */
+#define IMX662_HMAX_REG_LSB                          0x302C
+#define IMX662_HMAX_REG_MSB                          0x302D
+
+/* Exposure register */
+#define IMX662_EXP_REG_LSB                          0x3050
+#define IMX662_EXP_REG_MID                          0x3051
+#define IMX662_EXP_REG_MSB                          0x3052
+
+/* Global gain registers (analog, 16-bit) */
+#define IMX662_AGAIN_REG_LSB                       0x3070
+#define IMX662_AGAIN_REG_MSB                       0x3071
+
+/* Digital gain registers (16-bit) */
+#define IMX662_DGAIN_REG_LSB                       0x0910
+#define IMX662_DGAIN_REG_MSB                       0x0911
+
