+static td_void cmos_comm_sns_reg_info_init(cis_info *cis, ot_isp_sns_state *sns_state)
+{
+    td_u32 i;
+
+    sns_state->regs_info[0].sns_type = OT_ISP_SNS_TYPE_I2C;
+    sns_state->regs_info[0].com_bus.i2c_dev = cis->bus_info.i2c_dev;
+    sns_state->regs_info[0].cfg2_valid_delay_max = 2;
+    sns_state->regs_info[0].reg_num = REG_MAX_IDX;
+
+    for (i = 0; i < sns_state->regs_info[0].reg_num; i++) {
+        sns_state->regs_info[0].i2c_data[i].update = TD_TRUE;
+        sns_state->regs_info[0].i2c_data[i].dev_addr = IMX662_I2C_ADDR;
+        sns_state->regs_info[0].i2c_data[i].addr_byte_num = IMX662_ADDR_BYTE;
+        sns_state->regs_info[0].i2c_data[i].data_byte_num = IMX662_DATA_BYTE;
+    }
+
+    /* Page select */
+    sns_state->regs_info[0].i2c_data[PAGE_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[PAGE_IDX].reg_addr = 0x3000;
+
+    /* EXP_H */
+    sns_state->regs_info[0].i2c_data[EXP_REG_MSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[EXP_REG_MSB_IDX].reg_addr = 0x3052;
+
+    /* EXP_MID */
+    sns_state->regs_info[0].i2c_data[EXP_REG_MID_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[EXP_REG_MID_IDX].reg_addr = 0x3051;
+
+    /* EXP_LSB */
+    sns_state->regs_info[0].i2c_data[EXP_REG_LSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[EXP_REG_LSB_IDX].reg_addr = 0x3050;
+
+    /* VMAX H */
+    sns_state->regs_info[0].i2c_data[VMAX_REG_MSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[VMAX_REG_MSB_IDX].reg_addr = 0x302A;
+
+    /* VMAX M */
+    sns_state->regs_info[0].i2c_data[VMAX_REG_MID_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[VMAX_REG_MID_IDX].reg_addr = 0x3029;
+
+    /* VMAX L */
+    sns_state->regs_info[0].i2c_data[VMAX_REG_LSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[VMAX_REG_LSB_IDX].reg_addr = 0x3028;
+
+    /* AGAIN L */
+    sns_state->regs_info[0].i2c_data[AGAIN_REG_LSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[AGAIN_REG_LSB_IDX].reg_addr = 0x0900;
+
+    /* AGAIN M */
+    sns_state->regs_info[0].i2c_data[AGAIN_REG_MSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[AGAIN_REG_MSB_IDX].reg_addr = 0x0901;
+
+    /* DGAIN L */
+    sns_state->regs_info[0].i2c_data[DGAIN_REG_LSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[DGAIN_REG_LSB_IDX].reg_addr = 0x0910;
+
+    /* DGAIN H */
+    sns_state->regs_info[0].i2c_data[DGAIN_REG_MSB_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[DGAIN_REG_MSB_IDX].reg_addr = 0x0911;
+
+    /* Group hold */
+    sns_state->regs_info[0].i2c_data[VALUE_IDX].delay_frame_num = 0;
+    sns_state->regs_info[0].i2c_data[VALUE_IDX].reg_addr = 0x3001;
+
+    return;
+}
+
+static td_void cmos_sns_reg_info_update(ot_vi_pipe vi_pipe, ot_isp_sns_state *sns_state)
+{
+    td_u32 i;
+    ot_unused(vi_pipe);
+
+    for (i = 0; i < sns_state->regs_info[0].reg_num; i++) {
+        if (sns_state->regs_info[0].i2c_data[i].data == sns_state->regs_info[1].i2c_data[i].data) {
+            sns_state->regs_info[0].i2c_data[i].update = TD_FALSE;
+        } else {
+            sns_state->regs_info[0].i2c_data[i].update = TD_TRUE;
+        }
+    }
+
+    return;
+}
+
+static td_s32 cmos_isp_get_sns_regs_info(ot_vi_pipe vi_pipe, ot_isp_sns_regs_info *sns_regs_info)
+{
+    cis_info *cis = TD_NULL;
+    ot_isp_sns_state *sns_state = TD_NULL;
+
+    sns_check_pipe_return(vi_pipe);
+    sns_check_pointer_return(sns_regs_info);
+
+    cis = cmos_get_info(vi_pipe);
+    sns_check_pointer_return(cis);
+
+    sns_state = cis->sns_state;
+    sns_check_pointer_return(sns_state);
+
+    if ((sns_state->sync_init == TD_FALSE) || (sns_regs_info->config == TD_FALSE)) {
+        cmos_comm_sns_reg_info_init(cis, sns_state);
+        sns_state->sync_init = TD_TRUE;
+    } else {
+        cmos_sns_reg_info_update(vi_pipe, sns_state);
+    }
+
+    sns_regs_info->config = TD_FALSE;
+    (td_void)memcpy_s(sns_regs_info, sizeof(ot_isp_sns_regs_info),
+        &sns_state->regs_info[0], sizeof(ot_isp_sns_regs_info));
+    (td_void)memcpy_s(&sns_state->regs_info[1], sizeof(ot_isp_sns_regs_info),
+        &sns_state->regs_info[0], sizeof(ot_isp_sns_regs_info));
+    sns_state->fl[1] = sns_state->fl[0];
+
+    return TD_SUCCESS;
+}
