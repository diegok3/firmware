+    isp_def->wdr_switch_attr.exp_ratio[0] = 0x40;
+
+    isp_def->sns_mode.sns_id = IMX662_ID;
+    isp_def->sns_mode.sns_mode = sns_state->img_mode;
+    isp_def->sns_mode.dng_raw_format.bits_per_sample = 10; /* 10bit output */
+    isp_def->sns_mode.dng_raw_format.white_level = 1023;
+    isp_def->sns_mode.valid_dng_raw_format = TD_FALSE;
+
+    return TD_SUCCESS;
+}
