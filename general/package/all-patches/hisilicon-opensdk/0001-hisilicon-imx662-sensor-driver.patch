diff --git a/libraries/sensor/hi3516cv6xx/sony_imx662/imx662_sensor_ctrl.c b/libraries/sensor/hi3516cv6xx/sony_imx662/imx662_sensor_ctrl.c
new file mode 100644
--- /dev/null
+++ b/libraries/sensor/hi3516cv6xx/sony_imx662/imx662_sensor_ctrl.c
@@ -0,0 +1,211 @@
+/*
+  Copyright (c), 2001-2025, Shenshu Tech. Co., Ltd.
+ */
+
+#include "sensor_common.h"
+#include "imx662_cmos.h"
+#include "imx662_cfg.h"
+
+static void imx662_default_reg_init(cis_info *cis)
+{
+    td_u32 i;
+    td_s32 ret = TD_SUCCESS;
+    ot_isp_sns_state *past_sensor = TD_NULL;
+
+    past_sensor = cis->sns_state;
+    for (i = 0; i < past_sensor->regs_info[0].reg_num; i++) {
+        ret += cis_write_reg(&cis->i2c,
+            past_sensor->regs_info[0].i2c_data[i].reg_addr,
+            past_sensor->regs_info[0].i2c_data[i].data);
+    }
+
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write register failed!\n");
+    }
+    return;
+}
+
+td_s32 imx662_reg_init(cis_info *cis, const cis_reg_cfg *cfg, td_u32 len)
+{
+    td_u32 i;
+
+    for (i = 0; i < len; i++) {
+        sns_check_return(cis_write_reg(&cis->i2c, cfg->addr, cfg->data));
+        cfg++;
+    }
+
+    imx662_default_reg_init(cis);
+
+    return TD_SUCCESS;
+}
+
+td_s32 imx662_linear_init(cis_info *cis, td_u32 vmax, td_u32 hmax, td_u8 lane_mode, td_u8 datarate,
+    td_u8 adbit, td_u8 mdbit)
+{
+    td_s32 ret;
+    td_u32 len;
+    const cis_reg_cfg *cfg = g_imx662_init_seq;
+
+    sns_check_pointer_return(cis);
+
+    len = IMX662_INIT_SEQ_LEN;
+    ret = imx662_reg_init(cis, cfg, len);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662_reg_init failed!\n");
+        return ret;
+    }
+
+    /* Mode-specific registers */
+    /* DATARATE_SEL */
+    ret = cis_write_reg(&cis->i2c, 0x3015, datarate);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3015 failed!\n");
+        return ret;
+    }
+
+    /* WINMODE */
+    ret = cis_write_reg(&cis->i2c, 0x3018, IMX662_WINMODE_ALLPIXEL);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3018 failed!\n");
+        return ret;
+    }
+
+    /* LANEMODE */
+    ret = cis_write_reg(&cis->i2c, 0x3040, lane_mode);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3040 failed!\n");
+        return ret;
+    }
+
+    /* ADBIT */
+    ret = cis_write_reg(&cis->i2c, 0x3022, adbit);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3022 failed!\n");
+        return ret;
+    }
+
+    /* MDBIT */
+    ret = cis_write_reg(&cis->i2c, 0x3023, mdbit);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3023 failed!\n");
+        return ret;
+    }
+
+    /* HMAX */
+    ret = cis_write_reg(&cis->i2c, 0x302C, (hmax >> 8) & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x302C failed!\n");
+        return ret;
+    }
+    ret = cis_write_reg(&cis->i2c, 0x302D, hmax & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x302D failed!\n");
+        return ret;
+    }
+
+    /* VMAX */
+    ret = cis_write_reg(&cis->i2c, 0x3028, vmax & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3028 failed!\n");
+        return ret;
+    }
+    ret = cis_write_reg(&cis->i2c, 0x3029, (vmax >> 8) & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3029 failed!\n");
+        return ret;
+    }
+    ret = cis_write_reg(&cis->i2c, 0x302A, (vmax >> 16) & 0xF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x302A failed!\n");
+        return ret;
+    }
+
+    /* Exit standby */
+    ret = cis_write_reg(&cis->i2c, 0x3000, IMX662_STANDBY_EXIT);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write 0x3000 exit standby failed!\n");
+        return ret;
+    }
+
+    /* Mirror normal */
+    ret = cis_write_reg(&cis->i2c, IMX662_REG_MIRROR_FLIP, IMX662_MIRROR_NORMAL);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write mirror/flip failed!\n");
+        return ret;
+    }
+
+    return TD_SUCCESS;
+}
+
+td_s32 imx662_standby_mode(cis_info *cis)
+{
+    td_s32 ret;
+    sns_check_pointer_return(cis);
+    ret = cis_write_reg(&cis->i2c, 0x3000, IMX662_STANDBY_ENTER);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write standby failed!\n");
+        return ret;
+    }
+    return TD_SUCCESS;
+}
+
+td_s32 imx662_restart_mode(cis_info *cis, td_u32 vmax, td_u32 hmax, td_u8 lane_mode, td_u8 datarate)
+{
+    td_s32 ret;
+    sns_check_pointer_return(cis);
+
+    ret = cis_write_reg(&cis->i2c, 0x3000, IMX662_STANDBY_ENTER);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write standby failed!\n");
+        return ret;
+    }
+
+    ret = cis_write_reg(&cis->i2c, 0x3015, datarate);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write DATARATE_SEL failed!\n");
+        return ret;
+    }
+
+    ret = cis_write_reg(&cis->i2c, 0x3040, lane_mode);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write LANEMODE failed!\n");
+        return ret;
+    }
+
+    ret = cis_write_reg(&cis->i2c, 0x302C, (hmax >> 8) & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write HMAX high failed!\n");
+        return ret;
+    }
+    ret = cis_write_reg(&cis->i2c, 0x302D, hmax & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write HMAX low failed!\n");
+        return ret;
+    }
+
+    ret = cis_write_reg(&cis->i2c, 0x3028, vmax & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write VMAX low failed!\n");
+        return ret;
+    }
+    ret = cis_write_reg(&cis->i2c, 0x3029, (vmax >> 8) & 0xFF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write VMAX mid failed!\n");
+        return ret;
+    }
+    ret = cis_write_reg(&cis->i2c, 0x302A, (vmax >> 16) & 0xF);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write VMAX high failed!\n");
+        return ret;
+    }
+
+    cis_delay_ms(1);
+
+    ret = cis_write_reg(&cis->i2c, 0x3000, IMX662_STANDBY_EXIT);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("write exit standby failed!\n");
+        return ret;
+    }
+
+    return TD_SUCCESS;
+}
