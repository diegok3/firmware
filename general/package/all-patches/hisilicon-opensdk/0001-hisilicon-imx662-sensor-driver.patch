@@ -0,0 +1,50 @@
+/*
+  Copyright (c), 2001-2025, Shenshu Tech. Co., Ltd.
+ */
+
+#ifndef IMX662_CFG_H_
+#define IMX662_CFG_H_
+
+#ifdef __cplusplus
+#if __cplusplus
+extern "C" {
+#endif
+#endif
+
+#include "sensor_common.h"
+
+/* IMX662 AllPixel mode global init sequence (written once at cmos_isp_init).
+ * Mode-specific registers (HMAX, DATARATE_SEL, LANEMODE, ADBIT, MDBIT)
+ * are configured per-mode in imx662_cmos.c set_image_mode function. */
+static const cis_reg_cfg g_imx662_init_seq[] = {
+    {0x3000, 0x01},    /* enter standby */
+    {0x3001, 0x00},    /* REGHOLD release */
+    {0x3002, 0x01},    /* XMSTA start */
+    {0x30A4, 0x02},    /* XVSOUTSEL */
+    {0x30DC, 0x32},    /* BLKLEVEL */
+    {0x3444, 0xAC},    /* PLL_ctrl1 */
+    {0x3445, 0x09},    /* PLL_ctrl2 */
+    {0x3446, 0x01},    /* PLL_ctrl3 */
+    {0x349E, 0x05},    /* MIPI_TX_CTRL1 */
+    {0x349F, 0x19},    /* MIPI_TX_CTRL2 */
+    {0x34A0, 0x00},    /* MIPI_TX_CTRL3 */
+    {0x34A1, 0x01},    /* MIPI_TX_CTRL4 */
+    {0x34A2, 0x92},    /* MIPI_PHY_Tx1 */
+    {0x34A4, 0x91},    /* MIPI_PHY_Tx2 */
+    {0x34A6, 0x8C},    /* MIPI_PHY_Tx3 */
+    {0x34A8, 0x87},    /* MIPI_PHY_Tx4 */
+    {0x34AA, 0x82},    /* MIPI_PHY_Tx5 */
+    {0x34AC, 0x78},    /* MIPI_PHY_Tx6 */
+    {0x34AE, 0x6E},    /* MIPI_PHY_Tx7 */
+    {0x3014, 0x03},    /* INCK_SEL = 3 (27MHz, board MCLK) */
+};
+
+#define IMX662_INIT_SEQ_LEN   (sizeof(g_imx662_init_seq) / sizeof(g_imx662_init_seq[0]))
+
+#ifdef __cplusplus
+#if __cplusplus
+}
+#endif
+#endif
+
+#endif /* IMX662_CFG_H_ */
