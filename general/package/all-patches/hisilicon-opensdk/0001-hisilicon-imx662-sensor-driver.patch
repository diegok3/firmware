+    sns_state = cis->sns_state;
+    sns_check_pointer_return(sns_state);
+
+    memset_s(isp_def, sizeof(ot_isp_cmos_default), 0, sizeof(ot_isp_cmos_default));
+
+    /* All tuning keys left 0: ISP uses built-in defaults for CLUT/DPC/WDR/LSC/ACS
+     * and the linear pipeline (demosaic, sharpen, drc, bayer_nr, gamma, etc.).
+     * Populate per-sensor tuning tables once measured. */
