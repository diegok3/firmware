+static td_void cmos_isp_config_image_mode_param(ot_vi_pipe vi_pipe, td_u8 sns_image_mode,
+    ot_isp_sns_state *sns_state)
+{
+    ot_unused(vi_pipe);
+
+    switch (sns_image_mode) {
+        case 0:
+        case 1:
+        case 2:
+        default:
+            sns_state->fl_std = IMX662_VMAX_DEFAULT;
+            break;
+    }
+
+    return;
+}
