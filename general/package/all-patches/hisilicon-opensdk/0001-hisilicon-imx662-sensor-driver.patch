+static td_void imx662_preload_set_lane_mode(td_void)
+{
+    td_s32 fd;
+    lane_divide_mode_t lane_mode = LANE_DIVIDE_MODE_0;
+
+    /* majestic calls SET_DEV_ATTR before cmos_isp_init, which fails with
+     * "mipirx not set lane mode" because g_mipirx_init is FALSE.  Run
+     * SET_HS_MODE at dlopen time so the MIPI RX is ready before majestic
+     * configures the device attr. */
+    fd = open("/dev/ot_mipi_rx", O_RDWR);
+    if (fd < 0) {
+        isp_err_trace("imx662: open /dev/ot_mipi_rx failed (preload)\n");
+        return;
+    }
+    (td_void)ioctl(fd, OT_MIPI_SET_HS_MODE, &lane_mode);
+    close(fd);
+}
+
+__attribute__((constructor)) static td_void imx662_sns_ctor(td_void)
+{
+    imx662_preload_set_lane_mode();
+}
+
+static td_void imx662_enable_mclk(td_void)
+{
+    td_s32 fd;
+    td_s32 ret;
+    lane_divide_mode_t lane_mode = LANE_DIVIDE_MODE_0;
+    sns_clk_source_t clk_source = 0;
+    sns_rst_source_t rst_source = 0;
+
+    fd = open("/dev/ot_mipi_rx", O_RDWR);
+    if (fd < 0) {
+        isp_err_trace("imx662: open /dev/ot_mipi_rx failed\n");
+        return;
+    }
+
+    ret = ioctl(fd, OT_MIPI_SET_HS_MODE, &lane_mode);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: SET_HS_MODE failed: %d\n", ret);
+    }
+
+    ret = ioctl(fd, OT_MIPI_ENABLE_SENSOR_CLOCK, &clk_source);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: ENABLE_SENSOR_CLOCK failed: %d\n", ret);
+    }
+
+    /* Sensor reset sequence: reset → 10ms → unreset → 100ms PLL lock */
+    ret = ioctl(fd, OT_MIPI_RESET_SENSOR, &rst_source);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: RESET_SENSOR failed: %d\n", ret);
+    }
+    usleep(10000);
+
+    ret = ioctl(fd, OT_MIPI_UNRESET_SENSOR, &rst_source);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: UNRESET_SENSOR failed: %d\n", ret);
+    }
+    usleep(100000);
+
+    close(fd);
+}
+
+static td_void cmos_isp_init(ot_vi_pipe vi_pipe)
+{
+    CB_TRACE();
+    td_s32 ret;
+    cis_info *cis = TD_NULL;
+    ot_isp_sns_state *sensor_state = TD_NULL;
+
+    sns_check_pipe_void_return(vi_pipe);
+
+    cis = cmos_get_info(vi_pipe);
+    sns_check_pointer_void_return(cis);
+
+    sensor_state = cis->sns_state;
+    sns_check_pointer_void_return(sensor_state);
+
+    cis->i2c.addr = IMX662_I2C_ADDR;
+    cis->i2c.addr_byte_num = IMX662_ADDR_BYTE;
+    cis->i2c.data_byte_num = IMX662_DATA_BYTE;
+
+    isp_err_trace("imx662: cmos_isp_init i2c_dev=%d\n", cis->bus_info.i2c_dev);
+
+    imx662_enable_mclk();
+
+    ret = cis_i2c_init(cis);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: i2c init FAILED ret=0x%x\n", ret);
+        return;
+    }
+
+    ret = imx662_reg_init(cis, g_imx662_init_seq, IMX662_INIT_SEQ_LEN);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: global init FAILED ret=0x%x\n", ret);
+        return;
+    }
+
+    ret = imx662_linear_init(cis, IMX662_VMAX_DEFAULT, IMX662_HMAX_1080P_30FPS,
+        IMX662_LANEMODE_1LANE, IMX662_DATARATE_891,
+        IMX662_ADBIT_12BIT, IMX662_MDBIT_12BIT);
+    if (ret != TD_SUCCESS) {
+        isp_err_trace("imx662: mode init FAILED ret=0x%x\n", ret);
+        return;
+    }
+
+    sensor_state->init = TD_TRUE;
+
+    return;
+}
