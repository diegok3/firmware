+/* Runtime sensor-clock knob (waybeam parity).
+ * Writing a known MCLK frequency in Hz reprograms the sensor0 clock divider
+ * (CRG 0x8440, base 0x11010000); writing a raw CRG value < 65536 writes it
+ * verbatim so unknown encodings can be probed on-device.  Values observed in
+ * this file: 0xA001 = 27 MHz, 0x4001 = 24 MHz, 0x8010 = 37.125 MHz. */
+static unsigned int g_sns0_clk_crg;
+
+static int sns0_clk_hz_set(const char *val, const struct kernel_param *kp)
+{
+    unsigned int freq;
+    unsigned int crg;
+    int ret;
+
+    ret = kstrtouint(val, 0, &freq);
+    if (ret != 0) {
+        return ret;
+    }
+    if (freq < 0x10000) {
+        crg = freq;          /* raw CRG encoding probe */
+    } else {
+        switch (freq) {
+        case 37125000: crg = 0x8010; break; /* 37.125 MHz */
+        case 27000000: crg = 0xA001; break; /* 27 MHz */
+        case 24000000: crg = 0x4001; break; /* 24 MHz */
+        default: return -EINVAL;
+        }
+    }
+    if (g_reg_crg_base == NULL) {
+        return -EAGAIN;
+    }
+    sys_writel(g_reg_crg_base, 0x8440, crg);
+    g_sns0_clk_crg = crg;
+    return 0;
+}
+
+static const struct kernel_param_ops g_sns0_clk_hz_ops = {
+    .set = sns0_clk_hz_set,
+    .get = param_get_uint,
+};
+
+module_param_cb(sns0_clk_hz, &g_sns0_clk_hz_ops, &g_sns0_clk_crg, 0600);
+
